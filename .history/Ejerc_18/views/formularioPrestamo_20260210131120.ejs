<h2>Prestar Libro</h2>

<form action="/prestamo/nuevo" method="POST" class="card">
  <input type="hidden" name="libro_id" value="<%= libro_id %>">

  <div class="form-group">
    <label>Nombre del prestatario</label>
    <input type="text" name="nombre_prestatario" required>
  </div>

  <div class="form-group">
    <label>Fecha de devolución</label>
    <input type="date" name="fecha_devolucion" required>
  </div>

  <button>Guardar Préstamo</button>
</form>
