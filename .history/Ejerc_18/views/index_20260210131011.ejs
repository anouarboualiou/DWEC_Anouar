<h2>Catálogo de libros</h2>

<table>
  <thead>
    <tr>
      <th>Título</th>
      <th>Autor</th>
      <th>Estado</th>
    </tr>
  </thead>
  <tbody>
    <% libros.forEach(libro => { %>
      <tr>
        <td>
          <a href="/libro/<%= libro.id %>">
            <%= libro.titulo %>
          </a>
        </td>
        <td><%= libro.autor %></td>
        <td><%= libro.estado %></td>
      </tr>
    <% }) %>
  </tbody>
</table>
