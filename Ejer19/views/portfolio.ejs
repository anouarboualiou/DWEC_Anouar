<%- include('partials/header') %>

<div class="row justify-content-center">

    <div class="col-lg-10">

        <!-- PERFIL -->
        <div class="card shadow-sm mb-4 mt-4">

            <div class="card-body text-center p-5">

                <% if(user.photo) { %>

                    <img
                        src="<%= user.photo %>"
                        alt="Foto perfil"
                        class="rounded-circle mb-3"
                        width="120"
                        height="120"
                        style="object-fit: cover;"
                    >

                <% } %>

                <h1 class="mb-2">
                    <%= user.username %>
                </h1>

                <p class="text-muted mb-3">
                    <%= user.bio || 'Sin biografía disponible' %>
                </p>

                <p class="mb-0">
                    <strong>Email:</strong>
                    <%= user.email %>
                </p>

            </div>

        </div>

        <div class="row">

            <!-- REDES -->
            <div class="col-md-4">

                <div class="card shadow-sm mb-4">

                    <div class="card-body">

                        <h3 class="mb-4">Redes Sociales</h3>

                        <% socialLinks.forEach(link => { %>

                            <div class="border rounded p-3 mb-3">

                                <strong class="d-block mb-2">
                                    <%= link.platform %>
                                </strong>

                                <a
                                    href="<%= link.url %>"
                                    target="_blank"
                                >
                                    Ver Perfil
                                </a>

                            </div>

                        <% }) %>

                    </div>

                </div>

            </div>

            <!-- PROYECTOS -->
            <div class="col-md-8">

                <div class="card shadow-sm mb-4">

                    <div class="card-body">

                        <h3 class="mb-4">Proyectos</h3>

                        <% projects.forEach(project => { %>

                            <div class="border rounded p-4 mb-4">

                                <h4 class="mb-2">
                                    <%= project.title %>
                                </h4>

                                <p class="text-muted">
                                    <%= project.description %>
                                </p>

                                <div class="d-flex gap-2">

                                    <% if(project.repo_url) { %>

                                        <a
                                            href="<%= project.repo_url %>"
                                            target="_blank"
                                            class="btn btn-dark btn-sm"
                                        >
                                            Repo
                                        </a>

                                    <% } %>

                                    <% if(project.live_url) { %>

                                        <a
                                            href="<%= project.live_url %>"
                                            target="_blank"
                                            class="btn btn-primary btn-sm"
                                        >
                                            Demo
                                        </a>

                                    <% } %>

                                </div>

                            </div>

                        <% }) %>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<%- include('partials/footer') %>